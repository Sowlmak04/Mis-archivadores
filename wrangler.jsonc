{
  "name": "mis-archivadores",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-06",

  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "mis-archivadores-db",
      "database_id": "d9075945-a7eb-417d-9383-8a82318c75b4"
    }
  ],

  "r2_buckets": [
    {
      "binding": "IMAGES",
      "bucket_name": "mis-archivadores"
    }
  ]
}